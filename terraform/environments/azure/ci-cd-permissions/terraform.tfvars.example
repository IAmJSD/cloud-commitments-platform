# Azure CI/CD Permissions - example tfvars
# Copy to terraform.tfvars and fill in your values.
#
# Prerequisites: Azure CLI logged in (az login) with an account that has
# Owner or User Access Administrator on the target subscription.
#
# ─── subscription_id ───────────────────────────────────────────────────────────
# The subscription where the custom deploy role will be created and assigned.
#
# List all subscriptions you have access to:
#   az account list --query "[].{name:name, id:id}" --output table
#
# Show the currently active subscription:
#   az account show --query id --output tsv
#
subscription_id = "00000000-0000-0000-0000-000000000000"

# ─── github_repo ───────────────────────────────────────────────────────────────
# GitHub repository (owner/name) whose Actions workflows will authenticate
# via Azure AD Federated Identity Credentials (keyless — no client secrets).
#
# Federated credentials are created for:
#   - main branch deployments: repo:<owner>@<owner_id>/<name>@<repo_id>:ref:refs/heads/main
#   - each entry in github_environments: repo:<owner>@<owner_id>/<name>@<repo_id>:environment:<name>
#
# No pull_request-subject credential is created (see #90): it is not scoped to
# any branch or environment protection, and nothing in this repo authenticates
# to Azure on a pull_request trigger.
#
# Set to "" to skip federated credential and service principal creation.
#
github_repo = "LeanerCloud/cloud-commitments-platform"

# ─── github_owner_id / github_repo_id ───────────────────────────────────────────
# Immutable numeric ids. Trust subjects are built as
# repo:<owner>@<owner_id>/<name>@<repo_id>:..., so a renamed or re-created
# repository (same name, new id) cannot match. Required; look them up with:
#   gh api repos/LeanerCloud/cloud-commitments-platform --jq '.owner.id, .id'
# The repo must have the immutable OIDC subject enabled (Settings > Actions >
# OIDC); this must show use_immutable_subject true:
#   gh api repos/LeanerCloud/cloud-commitments-platform/actions/oidc/customization/sub
# Bootstrap module: applied by a privileged human, staging first; agents never apply.
#
github_owner_id = "86753534"
github_repo_id  = "1391259743"
