#!/usr/bin/env bash
# Grant service account impersonation for CUDly via gcloud.
# Target GCP project : {{.AccountName}} ({{.ProjectID}})
# Source cloud       : GCP (service account impersonation)
#
# Usage:
#   SOURCE_SERVICE_ACCOUNT=<email> bash {{.AccountSlug}}-gcp-sa-impersonation-cli.sh
#
# Requirements: gcloud CLI authenticated with a principal that has IAM admin on the target project.
set -euo pipefail

PROJECT_ID="${PROJECT_ID:-{{.ProjectID}}}"
SERVICE_ACCOUNT_EMAIL="${SERVICE_ACCOUNT_EMAIL:-{{.ServiceAccountEmail}}}"
: "${PROJECT_ID:?set PROJECT_ID to the target GCP project}"
: "${SERVICE_ACCOUNT_EMAIL:?set SERVICE_ACCOUNT_EMAIL to the CUDly service account in the target project}"
: "${SOURCE_SERVICE_ACCOUNT:?set SOURCE_SERVICE_ACCOUNT to the CUDly host SA email in the source project}"

gcloud config set project "${PROJECT_ID}"

echo "Creating target service account ${SERVICE_ACCOUNT_EMAIL} (if missing)..."
SA_NAME="${SERVICE_ACCOUNT_EMAIL%%@*}"
gcloud iam service-accounts create "${SA_NAME}" \
  --project="${PROJECT_ID}" \
  --display-name="CUDly target SA" \
  || echo "  (service account may already exist)"

# roles/commerceorgpolicy.commitmentAdmin (organization-scoped) and
# roles/billing.viewer (billing-account-scoped) both fail at project scope
# (#129). Grant exactly what CUDly needs instead: a project custom role
# holding only the two commitment-write permissions, plus the built-in
# roles/compute.viewer and roles/recommender.viewer for read access. This
# mirrors iac/federation/gcp-sa-impersonation/terraform/main.tf so the
# Terraform and CLI onboarding paths grant the same permission set.
CUSTOM_ROLE_ID="cudlyCommitmentWriter"
CUSTOM_ROLE_TITLE="CUDly Commitment Writer"
CUSTOM_ROLE_DESCRIPTION="Minimum permissions for CUDly to purchase and update committed use discounts."
CUSTOM_ROLE_PERMISSIONS="compute.commitments.create,compute.commitments.update"

echo "Creating custom role ${CUSTOM_ROLE_ID} (if missing)..."
if ! gcloud iam roles create "${CUSTOM_ROLE_ID}" \
  --project="${PROJECT_ID}" \
  --title="${CUSTOM_ROLE_TITLE}" \
  --description="${CUSTOM_ROLE_DESCRIPTION}" \
  --permissions="${CUSTOM_ROLE_PERMISSIONS}" \
  --stage=GA; then
  # Create fails whether the role already exists, was soft-deleted, or the
  # call hit a real error (permission denied, quota, ...). Distinguish them
  # with `describe` instead of assuming "already exists": a real failure
  # here must propagate (set -e), not be swallowed and leave the role
  # unbound below.
  echo "  role create failed; checking whether ${CUSTOM_ROLE_ID} already exists..."
  IS_DELETED=$(gcloud iam roles describe "${CUSTOM_ROLE_ID}" --project="${PROJECT_ID}" --format='value(deleted)')
  if [ "${IS_DELETED}" = "True" ]; then
    echo "  role was soft-deleted; undeleting..."
    gcloud iam roles undelete "${CUSTOM_ROLE_ID}" --project="${PROJECT_ID}"
  fi
  # The role may already exist with a different (e.g. stale, pre-#129)
  # permission set; converge it unconditionally rather than trusting
  # whatever is already there.
  echo "  role exists; converging its permissions..."
  gcloud iam roles update "${CUSTOM_ROLE_ID}" \
    --project="${PROJECT_ID}" \
    --title="${CUSTOM_ROLE_TITLE}" \
    --description="${CUSTOM_ROLE_DESCRIPTION}" \
    --permissions="${CUSTOM_ROLE_PERMISSIONS}" \
    --stage=GA
fi

echo "Granting required roles to ${SERVICE_ACCOUNT_EMAIL}..."
# add-iam-policy-binding is idempotent (re-adding an existing binding is a
# no-op success), so a failure here is real and must propagate (set -e),
# not be swallowed -- otherwise the script can print "=== Done ===" with a
# required role never actually bound.
for role in "projects/${PROJECT_ID}/roles/${CUSTOM_ROLE_ID}" roles/compute.viewer roles/recommender.viewer; do
  gcloud projects add-iam-policy-binding "${PROJECT_ID}" \
    --member="serviceAccount:${SERVICE_ACCOUNT_EMAIL}" \
    --role="${role}" \
    --condition=None \
    --quiet \
    --output=none
done

echo "Granting token creator to source SA ${SOURCE_SERVICE_ACCOUNT}..."
gcloud iam service-accounts add-iam-policy-binding "${SERVICE_ACCOUNT_EMAIL}" \
  --member="serviceAccount:${SOURCE_SERVICE_ACCOUNT}" \
  --role=roles/iam.serviceAccountTokenCreator \
  --project="${PROJECT_ID}" \
  --output=none

echo ""
echo "=== Done ==="
echo "project_id            : ${PROJECT_ID}"
echo "service_account_email : ${SERVICE_ACCOUNT_EMAIL}"
echo ""
echo "In CUDly, set gcp_auth_mode = application_default and the target SA email above."

{{- if .CUDlyAPIURL}}
echo ""
echo "Registering account with CUDly..."
# The pre-filled email is assigned on its own line, not as a ${VAR:-default},
# so a "}" in it cannot close the expansion early (#958, #1436).
CONTACT_EMAIL="${CUDLY_CONTACT_EMAIL:-}"
[ -n "$CONTACT_EMAIL" ] || CONTACT_EMAIL="{{.ContactEmail}}"
ACCOUNT_NAME="${CUDLY_ACCOUNT_NAME:-GCP ${PROJECT_ID}}"
# json_escape prints $1 escaped for use inside a JSON string: \ and " are
# backslash-escaped and a tab becomes \t. CR and LF are not handled: the
# email cannot hold them (net/mail rejects them), and CUDLY_ACCOUNT_NAME is
# set by the operator running this script.
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$(printf '\t')/\\\\t/g"
}
CONTACT_EMAIL_JSON=$(json_escape "$CONTACT_EMAIL")
ACCOUNT_NAME_JSON=$(json_escape "$ACCOUNT_NAME")
read -r -d '' PAYLOAD <<JSON || true
{
  "provider": "gcp",
  "external_id": "${PROJECT_ID}",
  "account_name": "${ACCOUNT_NAME_JSON}",
  "contact_email": "${CONTACT_EMAIL_JSON}",
  "gcp_auth_mode": "application_default",
  "gcp_project_id": "${PROJECT_ID}",
  "gcp_client_email": "${SERVICE_ACCOUNT_EMAIL}"
}
JSON
HTTP_CODE=$(curl -sS -o /tmp/cudly-register.out -w "%{http_code}" \
  -X POST "{{.CUDlyAPIURL}}/api/register" \
  -H "Content-Type: application/json" \
  -d "${PAYLOAD}")
case "$HTTP_CODE" in
  200|201) echo "Registration submitted. Reference token: $(jq -r .reference_token /tmp/cudly-register.out 2>/dev/null || cat /tmp/cudly-register.out)" ;;
  409)     echo "Registration already pending for this account — continuing." ;;
  *)       echo "ERROR: CUDly registration returned HTTP $HTTP_CODE:"; cat /tmp/cudly-register.out; exit 1 ;;
esac
{{- end}}
