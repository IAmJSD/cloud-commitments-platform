#!/usr/bin/env bash
# Create CUDly OIDC IAM role (workload identity federation) via aws-cli.
# Target AWS account : {{.AccountName}} ({{.AccountExternalID}})
# Source cloud       : {{.Source}}
#
# Usage:
#   bash {{.AccountSlug}}-aws-wif-cli.sh
#
# Requirements: aws-cli v2, jq, credentials for target account {{.AccountExternalID}}.
set -euo pipefail

ROLE_NAME="${ROLE_NAME:-CUDly-{{.AccountSlug}}}"
OIDC_ISSUER_URL="${OIDC_ISSUER_URL:-{{.OIDCIssuerURL}}}"
OIDC_AUDIENCE="${OIDC_AUDIENCE-{{.OIDCAudience}}}"
OIDC_AUDIENCE="${OIDC_AUDIENCE:-sts.amazonaws.com}"
OIDC_SUBJECT_CLAIM="${OIDC_SUBJECT_CLAIM:-{{.OIDCSubjectClaim}}}"
if [[ -z "${OIDC_SUBJECT_CLAIM}" ]]; then
  echo "Error: OIDC_SUBJECT_CLAIM is required. Without it the trust policy has no" >&2
  echo "       :sub condition and every identity ${OIDC_ISSUER_URL} can mint is able" >&2
  echo "       to assume this role. Set it to the calling workload's subject claim:" >&2
  echo "         GCP service account : its numeric unique ID (not the email)" >&2
  echo "         Azure managed identity: the object ID of the managed identity" >&2
  echo "       e.g. OIDC_SUBJECT_CLAIM=123456789012345678901 bash $0" >&2
  exit 1
fi
case "${OIDC_SUBJECT_CLAIM}" in
  *[$' \t\n\r\v\f']*|*'$'*|*'*'*)
    echo "Error: OIDC_SUBJECT_CLAIM must not contain whitespace, '\$' or '*'." >&2
    echo "       IAM expands \${...} policy variables inside Condition values, so a" >&2
    echo "       value such as \${accounts.google.com:sub} would expand to the token's" >&2
    echo "       own sub claim and match every identity the issuer can mint. '*' is" >&2
    echo "       compared literally by StringEquals and would silently produce a role" >&2
    echo "       nobody can assume." >&2
    exit 1
    ;;
esac
case "${OIDC_AUDIENCE}" in
  *[$' \t\n\r\v\f']*|*'$'*|*'*'*)
    echo "Error: OIDC_AUDIENCE must not contain whitespace, '\$' or '*'." >&2
    exit 1 ;;
esac
# Keep this issuer check equivalent to aws-target/terraform/variables.tf.
if ! [[ "$OIDC_ISSUER_URL" =~ ^https://[^/]+(/[^/].*[^/]|/[^/]+)?$ ]] || [[ "$OIDC_ISSUER_URL" == */ ]]; then
  echo "Error: OIDC_ISSUER_URL must start with https:// and must not end with a trailing slash." >&2
  exit 1
fi
command -v jq >/dev/null || { echo "Error: jq is required." >&2; exit 1; }
PROFILE_ARG=""
if [[ -n "${AWS_PROFILE:-}" ]]; then PROFILE_ARG="--profile ${AWS_PROFILE}"; fi

OIDC_HOST="${OIDC_ISSUER_URL#https://}"

echo "Creating/ensuring OIDC provider for ${OIDC_ISSUER_URL}..."
# shellcheck disable=SC2086
PROVIDERS=$(aws iam list-open-id-connect-providers $PROFILE_ARG --output json)
PROVIDER_ARN=$(jq -er --arg host "$OIDC_HOST" '
  if (.OpenIDConnectProviderList | type) != "array" then error("Invalid provider list")
  else [.OpenIDConnectProviderList[].Arn | select(split(":oidc-provider/")[1] == $host)]
    | if length > 1 then error("Multiple providers match the issuer") else .[0] // "" end
  end' <<< "$PROVIDERS")
if [[ -z "$PROVIDER_ARN" ]]; then
  # shellcheck disable=SC2086
  CREATED_PROVIDER=$(aws iam create-open-id-connect-provider $PROFILE_ARG \
    --url "${OIDC_ISSUER_URL}" \
    --client-id-list "${OIDC_AUDIENCE}" \
    --output json)
  PROVIDER_ARN=$(jq -er '.OpenIDConnectProviderArn | select(type == "string" and length > 0)' <<< "$CREATED_PROVIDER")
fi
if ! [[ "$PROVIDER_ARN" =~ ^arn:[a-z0-9-]+:iam::[0-9]{12}:oidc-provider/ ]] || [[ "${PROVIDER_ARN#*:oidc-provider/}" != "$OIDC_HOST" ]]; then
  echo "Error: returned provider ARN does not match OIDC_ISSUER_URL." >&2
  exit 1
fi
# shellcheck disable=SC2086
PROVIDER=$(aws iam get-open-id-connect-provider $PROFILE_ARG --open-id-connect-provider-arn "$PROVIDER_ARN" --output json)
if ! jq -e --arg host "$OIDC_HOST" --arg audience "$OIDC_AUDIENCE" '
  .Url == $host and
  (.ClientIDList | type == "array" and all(.[]; type == "string") and index($audience) != null) and
  (.ThumbprintList | type == "array" and all(.[]; type == "string" and
    test("^[0-9a-fA-F]{40}$") and . != "0000000000000000000000000000000000000000"))
  ' <<< "$PROVIDER" >/dev/null; then
  echo "Error: provider URL, audience or thumbprints do not match. Inspect $PROVIDER_ARN before rerunning; shared providers are not modified." >&2
  exit 1
fi

TRUST_POLICY=$(jq -n --arg host "$OIDC_HOST" --arg audience "$OIDC_AUDIENCE" \
  --arg subject "$OIDC_SUBJECT_CLAIM" --arg provider "$PROVIDER_ARN" '
{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Principal": {"Federated": $provider},
    "Action": "sts:AssumeRoleWithWebIdentity",
    "Condition": {"StringEquals": {
      ($host + ":aud"): $audience,
      ($host + ":sub"): $subject
    }}
  }]
}')

PERMISSIONS_POLICY=$(cat <<'JSON'
{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Resource": "*",
    "Action": [
      "ce:GetCostAndUsage","ce:GetReservationPurchaseRecommendation","ce:GetReservationUtilization",
      "ce:GetReservationCoverage","ce:GetSavingsPlansPurchaseRecommendation",
      "ce:GetSavingsPlansUtilization","ce:GetSavingsPlansCoverage",
      "ec2:PurchaseReservedInstancesOffering","ec2:DescribeReservedInstancesOfferings",
      "ec2:DescribeReservedInstances","ec2:DescribeInstanceTypeOfferings","ec2:DescribeInstanceTypes",
      "ec2:GetReservedInstancesExchangeQuote","ec2:AcceptReservedInstancesExchangeQuote",
      "rds:PurchaseReservedDBInstancesOffering","rds:DescribeReservedDBInstancesOfferings",
      "rds:DescribeReservedDBInstances",
      "elasticache:PurchaseReservedCacheNodesOffering",
      "elasticache:DescribeReservedCacheNodesOfferings","elasticache:DescribeReservedCacheNodes",
      "redshift:PurchaseReservedNodeOffering","redshift:DescribeReservedNodeOfferings",
      "redshift:DescribeReservedNodes",
      "memorydb:PurchaseReservedNodesOffering","memorydb:DescribeReservedNodesOfferings",
      "memorydb:DescribeReservedNodes",
      "savingsplans:CreateSavingsPlan","savingsplans:DescribeSavingsPlans",
      "savingsplans:DescribeSavingsPlansOfferings","savingsplans:DescribeSavingsPlansOfferingRates",
      "es:PurchaseReservedInstanceOffering","es:DescribeReservedInstanceOfferings",
      "es:DescribeReservedInstances",
      "ec2:DescribeRegions"
    ]
  },{
    "Effect": "Allow",
    "Resource": "arn:aws:ec2:*:*:reserved-instances/*",
    "Action": ["ec2:CreateTags"]
  }]
}
JSON
)

echo "Creating IAM role ${ROLE_NAME}..."
# shellcheck disable=SC2086
aws iam create-role $PROFILE_ARG \
  --role-name "${ROLE_NAME}" \
  --assume-role-policy-document "${TRUST_POLICY}" \
  --description "Role assumed by CUDly via workload identity federation" \
  --output json >/dev/null

# shellcheck disable=SC2086
aws iam put-role-policy $PROFILE_ARG \
  --role-name "${ROLE_NAME}" \
  --policy-name "CUDlyPermissions" \
  --policy-document "${PERMISSIONS_POLICY}"

# shellcheck disable=SC2086
ROLE_ARN=$(aws iam get-role $PROFILE_ARG --role-name "${ROLE_NAME}" --query 'Role.Arn' --output text)
echo ""
echo "=== Done ==="
echo "role_arn : ${ROLE_ARN}"
echo ""
echo "In CUDly, set aws_auth_mode = workload_identity_federation and paste the role_arn above."

{{- if .CUDlyAPIURL}}
echo ""
echo "Registering account with CUDly..."
CONTACT_EMAIL="${CUDLY_CONTACT_EMAIL:-{{.ContactEmail}}}"
# shellcheck disable=SC2086
TARGET_ACCOUNT_ID=$(aws sts get-caller-identity $PROFILE_ARG --query Account --output text)
ACCOUNT_NAME="${CUDLY_ACCOUNT_NAME:-AWS ${TARGET_ACCOUNT_ID}}"
read -r -d '' PAYLOAD <<JSON || true
{
  "provider": "aws",
  "external_id": "${TARGET_ACCOUNT_ID}",
  "account_name": "${ACCOUNT_NAME}",
  "contact_email": "${CONTACT_EMAIL}",
  "aws_auth_mode": "workload_identity_federation",
  "aws_role_arn": "${ROLE_ARN}"
}
JSON
HTTP_CODE=$(curl -sS -o /tmp/cudly-register.out -w "%{http_code}" \
  -X POST "{{.CUDlyAPIURL}}/api/register" \
  -H "Content-Type: application/json" \
  -d "${PAYLOAD}")
case "$HTTP_CODE" in
  200|201) echo "Registration submitted. Reference token: $(jq -r .reference_token /tmp/cudly-register.out 2>/dev/null || cat /tmp/cudly-register.out)" ;;
  409)     echo "Registration already pending for this account — continuing." ;;
  *)       echo "ERROR: CUDly registration returned HTTP $HTTP_CODE:"; cat /tmp/cudly-register.out; exit 1 ;;
esac
{{- end}}
