# Fixture (issue #505): roles a per-secret Secret Manager IAM resource must NOT
# grant without a waiver, including names that differ from an allowed role only
# slightly. Every `role =` line in this file must be reported, one finding per
# line; test-gcp-secret-scope.sh compares the reported line numbers with the
# `role =` lines here, so a miss in any one block fails the test. Must exit 1.
#
# Roles are case-sensitive in IAM, so a differently cased allowed name is not
# the allowed role. A role that is not a Secret Manager role at all
# (roles/owner) and a role that is not a literal (a local) are reported too:
# the guard cannot tell what either grants on the secret.

resource "google_secret_manager_secret_iam_member" "lookalike_1" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.admin"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_2" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretVersionManager"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_3" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.viewer"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_4" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretaccessor"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_5" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.SecretAccessor"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_6" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretAccessorAdmin"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_7" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretVersionAdderX"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_8" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretAccessor.x"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_9" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretAccessor "
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_10" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/owner"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "lookalike_11" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = local.writer_role
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_binding" "binding_admin" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.admin"
  members   = ["serviceAccount:workload@example.iam.gserviceaccount.com"]
}

resource "google_secret_manager_regional_secret_iam_member" "regional_version_manager" {
  project   = var.project_id
  location  = var.region
  secret_id = var.regional_secret_id
  role      = "roles/secretmanager.secretVersionManager"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_regional_secret_iam_binding" "regional_binding_admin" {
  project   = var.project_id
  location  = var.region
  secret_id = var.regional_secret_id
  role      = "roles/secretmanager.admin"
  members   = ["serviceAccount:workload@example.iam.gserviceaccount.com"]
}

resource "google_secret_manager_secret_iam_policy" "inline_admin" {
  project   = var.project_id
  secret_id = var.secret_id
  policy_data = jsonencode({
    bindings = [
      {
        role    = "roles/secretmanager.admin"
        members = ["serviceAccount:workload@example.iam.gserviceaccount.com"]
      },
    ]
  })
}
