# Fixture: the role name is assembled at plan time, so no static scanner can
# tell which role it is. The guard must refuse it rather than pass it. Must
# exit 1.

resource "google_project_iam_member" "assembled" {
  project = var.project_id
  role    = "roles/${var.service}.${var.level}"
  member  = "serviceAccount:${google_service_account.workload.email}"
}
