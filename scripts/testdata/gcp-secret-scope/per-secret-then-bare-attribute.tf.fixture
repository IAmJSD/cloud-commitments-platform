# Fixture: a top-level attribute (the tfvars shape) directly after a per-secret
# binding closes. The exemption must end with the block's closing brace, not
# wait for the next block header to reset it. Must exit 1.

resource "google_secret_manager_secret_iam_member" "ok" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.workload.email}"
}
role = "roles/secretmanager.admin"
