# Fixture: inside a per-secret IAM resource only a plain
# `role = "roles/secretmanager.X"` line is exempt. A Secret Manager mention on
# any other line there (here an inline for_each set) is still reported, so the
# exemption cannot be stretched into a carrier for other values. Must exit 1.

resource "google_secret_manager_secret_iam_member" "inline_set" {
  for_each = toset(["roles/secretmanager.admin"])

  project   = var.project_id
  secret_id = var.secret_id
  role      = each.value
  member    = "serviceAccount:${google_service_account.workload.email}"
}
