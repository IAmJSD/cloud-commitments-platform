# Fixture (issue #505): a per-secret role outside the allowed pair is accepted
# when a waiver with a reason sits on the line directly above it, the same
# escape hatch scope-wide grants have. Must exit 0, and exit 1 once the waiver
# is removed (test-gcp-secret-scope.sh asserts both).

resource "google_secret_manager_secret_iam_member" "metadata_viewer" {
  project   = var.project_id
  secret_id = var.secret_id
  # gcp-secret-scope: allow - reads secret metadata only, never a payload (fixture)
  role   = "roles/secretmanager.viewer"
  member = "serviceAccount:auditor@example.iam.gserviceaccount.com"
}
