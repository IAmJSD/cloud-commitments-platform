# Fixture (issue #505): the mutation from the #504 review. A per-secret binding
# that should be roles/secretmanager.secretVersionAdder grants
# roles/secretmanager.admin instead, which lets the member read every version,
# destroy versions, delete the secret and rewrite its IAM policy. The grant is
# per-secret, so it is not scope-wide, but it is still an over-grant. Must exit 1.

resource "google_secret_manager_secret_iam_member" "admin_password_writer" {
  secret_id = var.admin_password_secret_name
  role      = "roles/secretmanager.admin"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}
