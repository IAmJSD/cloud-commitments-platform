# Fixture: a per-secret binding (allowed) followed by a locals block carrying a
# Secret Manager role for a project grant. The per-secret allowance must end
# with its block and not leak onto what follows. Must exit 1.

resource "google_secret_manager_secret_iam_member" "ok" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.workload.email}"
}
locals {
  roles = ["roles/secretmanager.secretAccessor"]
}

resource "google_project_iam_member" "roles" {
  for_each = toset(local.roles)
  project  = var.project_id
  role     = each.value
  member   = "serviceAccount:${google_service_account.workload.email}"
}
