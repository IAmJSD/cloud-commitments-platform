# Fixture (issue #150): a per-secret binding whose body starts in column 0, with
# a column-0 `}` closing a nested block before a second resource. The
# per-secret exemption must not reach the project grant that follows, however
# the closing braces are laid out. Must exit 1.

resource "google_secret_manager_secret_iam_member" "unindented" {
project   = var.project_id
secret_id = var.secret_id
condition {
title      = "always"
expression = "true"
}
role   = "roles/secretmanager.secretAccessor"
member = "serviceAccount:workload@example.iam.gserviceaccount.com"
}
resource "google_project_iam_member" "after" {
project = var.project_id
role    = "roles/secretmanager.secretAccessor"
member  = "serviceAccount:workload@example.iam.gserviceaccount.com"
}
