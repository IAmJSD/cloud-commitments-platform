# Fixture (issue #505, negative direction): the two roles a per-secret Secret
# Manager IAM resource may grant, roles/secretmanager.secretAccessor (read a
# version) and roles/secretmanager.secretVersionAdder (add a version), in every
# per-secret resource type the guard exempts. Must exit 0.

resource "google_secret_manager_secret_iam_member" "reader" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_secret_iam_member" "writer" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretVersionAdder"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"

  condition {
    title      = "until-rotation"
    expression = "request.time < timestamp(\"2030-01-01T00:00:00Z\")"
  }
}

resource "google_secret_manager_secret_iam_binding" "readers" {
  project   = var.project_id
  secret_id = var.secret_id
  role      = "roles/secretmanager.secretAccessor"
  members   = ["serviceAccount:workload@example.iam.gserviceaccount.com"]
}

resource "google_secret_manager_regional_secret_iam_member" "regional_writer" {
  project   = var.project_id
  location  = var.region
  secret_id = var.regional_secret_id
  role      = "roles/secretmanager.secretVersionAdder"
  member    = "serviceAccount:workload@example.iam.gserviceaccount.com"
}

resource "google_secret_manager_regional_secret_iam_binding" "regional_readers" {
  project   = var.project_id
  location  = var.region
  secret_id = var.regional_secret_id
  role      = "roles/secretmanager.secretAccessor"
  members   = ["serviceAccount:workload@example.iam.gserviceaccount.com"]
}

resource "google_secret_manager_secret_iam_policy" "inline" {
  project   = var.project_id
  secret_id = var.secret_id
  policy_data = jsonencode({
    bindings = [
      {
        role    = "roles/secretmanager.secretAccessor"
        members = ["serviceAccount:workload@example.iam.gserviceaccount.com"]
      },
      {
        role    = "roles/secretmanager.secretVersionAdder"
        members = ["serviceAccount:workload@example.iam.gserviceaccount.com"]
      },
    ]
  })
}
